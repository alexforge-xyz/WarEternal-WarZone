# systemd unit — keeps the Next.js app running and restarts it on crash/reboot.
# Install:
#   sudo cp deploy/warzone.service /etc/systemd/system/warzone.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now warzone
#
# Adjust User= / paths if your droplet layout differs.

[Unit]
Description=War Eternal — WarZone (Next.js)
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/warzone
Environment=NODE_ENV=production
Environment=PORT=3002
# Load secrets into the process (Next also reads .env.local; this is belt+suspenders
# so ADMIN_* / SESSION_SECRET / SQLITE_PATH are definitely present at runtime).
# Leading `-` = missing file is not fatal.
EnvironmentFile=-/var/www/warzone/.env.local
ExecStart=/usr/bin/npm run start -- --port 3002
Restart=always
RestartSec=5

# SQLite lives on disk; give the process a clean stop so WAL can settle.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
