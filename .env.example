# Path to the SQLite file. Local default is fine for development; on the
# Droplet point this at a persistent path (e.g. /var/www/warzone/warzone.db).
SQLITE_PATH=warzone.db

# Signs the session cookie. Any long random string; changing it logs everyone out.
SESSION_SECRET=change-me-to-something-long-and-random

# First-run bootstrap only: these create the admin account the first time they
# are used to sign in. Once the account exists they are ignored — there is no
# permanent backdoor. Everyone else joins by one-time invite link.
ADMIN_NICK=[K6] TheMrLordicus
ADMIN_PASSWORD=change-me

# Cloudflare Turnstile (anti-bot on the sign-in and join forms).
# Unset → the check is skipped, so local dev works without keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
